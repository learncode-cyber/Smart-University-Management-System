# ============================================================================
# University Management System - Environment Configuration
# ============================================================================
#
# Copy this file to .env and modify values as needed
# $ cp .env.example .env
#
# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL username (internal container user)
# Default: ums_user
POSTGRES_USER=ums_user

# PostgreSQL password (internal container user)
# Default: ums_password
# IMPORTANT: Change this in production!
POSTGRES_PASSWORD=ums_password

# PostgreSQL database name
# Default: ums_db
POSTGRES_DB=ums_db

# PostgreSQL HOST PORT (machine port, not container port)
# Use this if your machine's 5432 port is already in use
# Default: 5433 (fallback if 5432 is occupied)
# Examples:
#   5432 = Standard PostgreSQL port
#   5433 = Alternate if 5432 is in use
#   3306 = MySQL standard port (if your 5432 is taken by MySQL)
POSTGRES_PORT=5433

# ============================================================================
# BACKEND CONFIGURATION
# ============================================================================

# Backend API server host port
# Default: 8000
BACKEND_PORT=8000

# JWT Secret Key for token signing
# IMPORTANT: Change this in production! Use a strong random string
# $ python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=dev-only-secret-change-in-production

# Default University ID (for seeding)
# Default: 1
DEFAULT_UNIVERSITY_ID=1

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# Frontend Vite development server port
# Default: 5173
FRONTEND_PORT=5173

# Backend URL as seen from frontend browser
# This is the URL the browser will use to call the backend
# Default: http://localhost:8000
# Examples:
#   http://localhost:8000 = Local development
#   http://api.example.com = Production
VITE_BACKEND_URL=http://localhost:8000

# ============================================================================
# USAGE EXAMPLES
# ============================================================================
#
# EXAMPLE 1: Standard Local Development (no port conflicts)
# ─────────────────────────────────────────────────────────
# POSTGRES_PORT=5432
# BACKEND_PORT=8000
# FRONTEND_PORT=5173
#
# EXAMPLE 2: Port Conflicts (5432 already in use)
# ──────────────────────────────────────────────────
# POSTGRES_PORT=5433        # Use alternate port for postgres
# BACKEND_PORT=8000
# FRONTEND_PORT=5173
#
# EXAMPLE 3: Non-Standard Ports (testing multiple instances)
# ───────────────────────────────────────────────────────────
# POSTGRES_PORT=5433
# BACKEND_PORT=8001
# FRONTEND_PORT=5174
#
# EXAMPLE 4: Production Configuration
# ────────────────────────────────────
# POSTGRES_PORT=5432
# BACKEND_PORT=8000
# FRONTEND_PORT=5173
# JWT_SECRET_KEY=your-super-secret-key-here-change-this
# VITE_BACKEND_URL=https://api.yourdomain.com
#
# ============================================================================
# IMPORTANT NOTES
# ============================================================================
#
# 1. Port Conflicts:
#    If "port already allocated" error occurs, it means that port is in use.
#    Change POSTGRES_PORT to 5433, 5434, etc. until you find a free port.
#
# 2. Database Initialization:
#    The seed script will automatically create:
#    - University record
#    - Departments
#    - Admin account (admin@university.edu / AdminPassword123!)
#
# 3. Security:
#    - NEVER commit .env file to git
#    - ALWAYS change JWT_SECRET_KEY in production
#    - ALWAYS change POSTGRES_PASSWORD in production
#
# 4. Docker Networking:
#    - Services communicate via service name (postgres, backend, frontend)
#    - POSTGRES_PORT is only for host machine access
#    - Containers always use port 5432 internally
#
# 5. Troubleshooting:
#    If services won't start:
#    a) Check port availability: netstat -an | grep LISTEN
#    b) Clean volumes: docker compose down -v
#    c) Rebuild: docker compose up --build
#
# ============================================================================
