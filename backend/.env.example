# Copy this file to .env and fill in real values for local (non-Docker) development.
# Docker Compose sets these directly as container env vars instead — see docker-compose.yml.

DATABASE_URL=postgresql+psycopg://ums_user:ums_password@localhost:5432/ums_db

# Generate a real secret for anything beyond local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=dev-only-secret-change-in-production

DEFAULT_UNIVERSITY_ID=1
LOW_ATTENDANCE_THRESHOLD_PERCENT=75.0
LOGIN_RATE_LIMIT=5/minute
